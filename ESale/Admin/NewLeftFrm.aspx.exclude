<%@ Page Language="C#" AutoEventWireup="true" CodeFile="NewLeftFrm.aspx.cs" Inherits="Admin_NewLeftFrm" %>
<%@ Register Assembly="AjaxControlToolkit" Namespace="AjaxControlToolkit" TagPrefix="asp" %>

<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml" style="background-color:#fab901;">
<head runat="server">
    <title></title>
    
     <link href="../css/ENewStyles.css" rel="stylesheet" type="text/css" />
    <script src="../js/jquery-1.3.2.min.js" type="text/javascript"></script>
    <script src="../js/jquery-1.2.1.min.js" type="text/javascript"></script>
    <script src="../js/menu.js" type="text/javascript"></script>
    
   <script type="text/javascript">
       $(document).ready(function() {

           $(".accordion2 h3").eq(0).addClass("active");
           $(".accordion2 p").eq(0).show();

           $(".accordion2 h3").click(function() {
               $(this).next("p").slideToggle("slow").siblings("p:visible").slideUp("slow");
               $(this).toggleClass("active");
               $(this).siblings("h3").removeClass("active");
           });

       });

    </script>

        
</head>
<body>
    <form id="form1" runat="server">
<asp:ToolkitScriptManager ID="scriptmanager" runat="server"></asp:ToolkitScriptManager>
<asp:UpdatePanel ID="Upd1" runat="server">
<ContentTemplate>
<asp:UpdateProgress ID="UpdateProgress1" runat="server" >
        <ProgressTemplate>
        <div class="load" style="margin-left:10px; margin-top:100px">
                        <table width="50%" border="0" align="center" cellpadding="0" cellspacing="5">
                            <tr>
                                <td align="center">
                                <img alt="" src="../images/ajax-loader.gif" width="120" height="80"  />
                                </td>
                           </tr>
                        </table>
           </div>
     </ProgressTemplate>
    </asp:UpdateProgress>
   <div class="MainCtnr" style="margin-top:8px;">
    <div class="ContentCtnr">
    <div class="leftColCtnr">
        <div class="leftpane">
            <div id="colapsableMenuBlock" runat="server">
            
            
                        
              
            </div>
        </div>
    </div>
    </div>
</div>
 </ContentTemplate>
 </asp:UpdatePanel>
    </form>
</body>
</html>
