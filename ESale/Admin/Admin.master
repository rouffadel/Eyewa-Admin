    <script type="text/javascript">
        $(document).ready(function() {
            // Sidebar Toggle functionality
            $(".menu-toggle-btn").on("click", function(e) {
                e.preventDefault();
                $(".wrapper").toggleClass("toggled");
                
                if ($(".wrapper").hasClass("toggled")) {
                    $(".menu-toggle-btn .fa").removeClass("fa-dedent").addClass("fa-indent");
                } else {
                    $(".menu-toggle-btn .fa").removeClass("fa-indent").addClass("fa-dedent");
                }
            });

            // Force MetisMenu initialization
            setTimeout(function() {
                if ($.fn.metisMenu) {
                    $("#menu").metisMenu();
                }
            }, 500);
        });
    </script>

